# Server-only values. Never commit real values.
# Database is optional while the site uses committed static job data.
DATABASE_URL=
# Keep maintenance writes protected. Use a distinct random value of at least 32 characters.
UPDATER_SECRET=
# Local Python collection / GitHub Actions
SITE_ORIGIN=
PUBLIC_FETCH_MODE=direct
# Optional if Vercel Deployment Protection also protects the automation URL.
VERCEL_AUTOMATION_BYPASS_SECRET=
