# Server-only values. Set in Vercel Production and Preview; never commit real values.
DATABASE_URL=
# Owner workspace password: at least 16 characters; choose a unique password.
APP_PASSWORD=
# Generate distinct random values of at least 32 characters.
SESSION_SECRET=
UPDATER_SECRET=
# Local Python collection / GitHub Actions
SITE_ORIGIN=
PUBLIC_FETCH_MODE=direct
# Optional if Vercel Deployment Protection also protects the automation URL.
VERCEL_AUTOMATION_BYPASS_SECRET=
